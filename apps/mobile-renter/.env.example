# Copia a .env para desarrollo local (gitignored). En EAS Build estos valores
# vienen de eas.json (env por perfil). Solo EXPO_PUBLIC_* llega al bundle.

# Backend: en un teléfono real NO sirve localhost — usa la IP de tu LAN
# (ej. http://192.168.1.20:8000/api/v1) o un túnel / la API desplegada.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Sitio web (destino del enlace de restablecer contraseña y del retorno de pago)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Supabase (proyecto rgxiyidijtoazcrmijly). La anon key es pública por diseño.
# Sin estas dos el cliente cae a un placeholder y NO hay login ni sesión.
EXPO_PUBLIC_SUPABASE_URL=https://rgxiyidijtoazcrmijly.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Subida de archivos: usa el fetch nativo de RN para que FormData mande el
# binario real. Ponlo en 0 solo para depurar con el fetch del polyfill.
EXPO_PUBLIC_USE_RN_FETCH=1

# MercadoPago. Sin public key la app entra en modo prueba y no llama a MP.
EXPO_PUBLIC_MP_PUBLIC_KEY=
# Fuerza el modo prueba aunque haya public key configurada.
EXPO_PUBLIC_PAGOS_PRUEBA=0

# Sentry. Vacío = captura de errores desactivada.
EXPO_PUBLIC_SENTRY_DSN=

# Modo E2E (Maestro): habilita fixtures de fotos. Solo "true" lo activa.
EXPO_PUBLIC_E2E_TEST=false

# Canales de soporte. Vacío = la opción no se muestra. Las variantes
# _VISIBLE son opcionales; sin ellas se formatea el número automáticamente.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_PHONE_VISIBLE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_WHATSAPP_VISIBLE=
