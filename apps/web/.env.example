# Variables de entorno del sitio web (Next.js). Copia a .env y completa.
# En Vercel se configuran en Project Settings → Environment Variables.

# API del backend
NEXT_PUBLIC_API_URL="https://arriendomiautoya.onrender.com/api/v1"

# Supabase (reset de contraseña que dispara la app móvil)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Google Analytics 4
NEXT_PUBLIC_GA_ID=""

# Google Maps JavaScript API — mapa de autos en la landing.
# Habilita "Maps JavaScript API" en Google Cloud y restringe la key por
# HTTP referrer (tu dominio de Vercel + localhost).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
