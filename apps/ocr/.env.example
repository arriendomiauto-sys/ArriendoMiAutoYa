# Microservicio de OCR — Arrienda Tu Auto

# Clave compartida con el backend. El backend la envía en el header X-OCR-Key.
# Déjala vacía en dev/tests para no exigir autenticación.
OCR_SERVICE_KEY=

# Si es True (o no hay credenciales de Vision), se usa el mock determinista.
USE_OCR_MOCK=true

# OCR real vía API REST (más simple, no requiere archivo de credenciales).
GOOGLE_CLOUD_VISION_API_KEY=

# OCR real vía SDK (service account JSON). Ruta al archivo de credenciales.
GOOGLE_APPLICATION_CREDENTIALS=

# Directorio local para resolver URLs /uploads/... servidas por el backend
# (sólo si comparten disco; en producción normalmente no aplica).
STORAGE_LOCAL_DIR=./uploads
