# Copia a .env para desarrollo local (gitignored). En producción los valores
# vienen del entorno del hosting (ver render.yaml).

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=cambia-esto-en-produccion

# Base de datos. Local: SQLite (se crea sola). Prod: connection string de
# Postgres de Supabase.
DATABASE_URL=sqlite:///./rentacar_dev.db

# Supabase (proyecto rgxiyidijtoazcrmijly)
SUPABASE_URL=https://rgxiyidijtoazcrmijly.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=arrienda-tu-auto-files

# OCR / Google Cloud Vision. Sin key real, el KYC NO auto-aprueba: todo
# queda en revisión manual (ver notas del KYC).
USE_OCR_MOCK=false
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Google Maps (Android del mapa nativo de la app)
GOOGLE_MAPS_API_KEY=

# Transbank Webpay Plus — credenciales públicas de INTEGRACION (sandbox).
# Para producción: pedir comercio real y cambiar TBK_ENVIRONMENT=PRODUCCION.
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY=579B532A7440BBAB610796F8393E2D5E
TBK_ENVIRONMENT=INTEGRACION

# CORS: JSON array con los orígenes del sitio web y de Expo web en dev.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]
