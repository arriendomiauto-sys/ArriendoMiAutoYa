# Plantilla de entorno local — copiar a .env y completar con las credenciales
# reales (ver Credenciales.env, fuera del repo). .env está en .gitignore.

ENVIRONMENT=development
DEBUG=True

# DB local (SQLite). El backend usa Base.metadata.create_all + seed_demo_data,
# pensado para SQLite local; no muta la base real. La Postgres de Supabase solo
# se usa desde el deployment (Render), donde DATABASE_URL se inyecta por
# variable de entorno.
DATABASE_URL=sqlite:///./rentacar_dev.db

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=arrienda-tu-auto-files

# Google Cloud Vision (OCR de cédula / licencia en /enrolamiento). En dev local
# queda en mock para no gastar dinero real; la key real va solo en el deployment.
# NUNCA exponer esta key en el bundle mobile (no EXPO_PUBLIC_*).
USE_OCR_MOCK=True
GOOGLE_CLOUD_VISION_API_KEY=

# Mercado Pago
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
PAGOS_SIMULADOS=True

# Verificación de identidad con proveedor externo (Didit, flujo hosted).
# El flag solo "prende" cuando están las 3: API_KEY + WORKFLOW_ID +
# WEBHOOK_SECRET. En dev local queda apagada: sin llamadas reales a Didit.
VERIFICACION_EXTERNA_HABILITADA=False
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://arriendomiautoya.cl/verificacion/retorno

# Historial vehicular por patente (Boostr, boostr.cl/patente). Bloqueado hasta
# que el cliente cree la cuenta en Boostr y confirme el proveedor — sin esto
# el cliente HTTP no se implementa (no hay contrato de API confirmado todavía).
BOOSTR_PATENTE_API_KEY=

# Envío de contratos firmados por correo (Resend, resend.com). Apagado si
# RESEND_API_KEY queda vacío (dev/tests) — firmar_contrato sigue funcionando
# igual, solo no manda el correo. RESEND_FROM_EMAIL necesita ser un dominio
# verificado de verdad en la cuenta de Resend del cliente antes de encender
# esto en producción; el default de abajo es un placeholder sin confirmar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contratos@arriendomiautoya.cl
