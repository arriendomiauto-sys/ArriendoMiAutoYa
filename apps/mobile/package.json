    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
