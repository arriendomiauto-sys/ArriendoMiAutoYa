{
  "expo": {
    "name": "Arrienda Tu Auto",
    "slug": "arrienda-tu-auto",
    "scheme": "arriendatuauto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.arriendatuauto.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Arrienda Tu Auto usa tu ubicación para mostrarte los autos disponibles cerca de ti en el mapa."
      }
    },
    "android": {
      "package": "cl.arriendatuauto.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDDoQbqpICrFbaIkiJ4V3jQAw7USg1BN1c"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Arrienda Tu Auto necesita acceso a tus fotos para publicar tu vehículo y verificar tus documentos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Arrienda Tu Auto necesita tu cámara para fotografiar tu cédula, tu licencia y tomar la selfie de verificación de identidad."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Arrienda Tu Auto usa tu ubicación para mostrarte los autos disponibles cerca de ti en el mapa."
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Arrienda Tu Auto usa Face ID para proteger el acceso a tu cuenta si activas el bloqueo biométrico."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Arrienda Tu Auto necesita tu cámara para escanear tu cédula automáticamente."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2b05af04-600a-4544-bc16-85fe714c68fb"
      }
    },
    "owner": "arriendomiautoya"
  }
}
