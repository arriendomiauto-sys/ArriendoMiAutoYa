{
  "expo": {
    "name": "Arrienda Tu Auto",
    "slug": "arrienda-tu-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#FAFAF9" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "cl.arriendatuauto.app" },
    "android": {
      "package": "cl.arriendatuauto.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#FAFAF9" }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      ["expo-image-picker", { "photosPermission": "Arrienda Tu Auto necesita acceso a tus fotos para publicar tu vehículo y verificar tus documentos." }],
      ["expo-camera", { "cameraPermission": "Arrienda Tu Auto necesita tu cámara para fotografiar tu cédula, tu licencia y tomar la selfie de verificación de identidad." }]
    ]
  }
}
