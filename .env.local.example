# Copiar a .env.local y completar con el valor real.

# El panel habla SOLO con esta API — nunca con Supabase directamente. El
# login/refresh de sesión (POST /auth/login, /auth/refresh) pasan por acá,
# que hace el intercambio con Supabase del lado del servidor.
# Local:      http://localhost:8000/api/v1
# Producción: https://arrienda-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://arrienda-api.onrender.com/api/v1
