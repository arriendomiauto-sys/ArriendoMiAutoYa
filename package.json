{
  "name": "arrienda-tu-auto",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "api:dev": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "api:test": "cd apps/api && pytest"
  },
  "devDependencies": {
    "turbo": "^1.13.0"
  }
}
